# Copy this file to .env and fill in the values (.env is git-ignored, so the token is never pushed).
# Leave the first two empty to run in demo mode with the bundled data snapshot.

# From Bioto (partner API): your access token and the id of your garden
BIOTO_TOKEN=your-token-here
GARDEN_UUID=your-garden-uuid

# Optional
# API_BASE=https://api.bioto.co
# PORT=3000
